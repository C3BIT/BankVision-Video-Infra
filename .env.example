# NOTE: after deploying, add this iptables rule on the host so egress
# can reach LiveKit without hairpin NAT (re-run after every reboot,
# or persist with: apt install iptables-persistent && netfilter-persistent save)
#
# iptables -t nat -I OUTPUT -d <YOUR_PUBLIC_IP> -p udp --dport 50000:50050 -j DNAT --to-destination 172.30.0.10
# iptables -t nat -I OUTPUT -d <YOUR_PUBLIC_IP> -p tcp --dport 7881 -j DNAT --to-destination 172.30.0.10
